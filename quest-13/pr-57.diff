 """Orders of Northwind Lunch."""
-from settings import PICKUP_TIME
+from settings import PICKUP_TIME, MAX_PREORDERS
 
 ORDERS = []
+PREORDERS = []
 
 
 def place_order(item):
     ORDERS.append(item)
     return f"Your {item} is ready at {PICKUP_TIME}."
+
+
+def place_preorder(item, day):
+    if len(PREORDERS) >= MAX_PREORDERS:
+        raise ValueError("too many pre-orders")
+    PREORDERS.append((item, day))
+    return f"Your {item} will be ready on {day} at {PICKUP_TIME}."
