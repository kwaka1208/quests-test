 """Lunch points of Northwind. You get half of the price as points."""
+import math
 
 
 def points(price):
-    return round(price * 0.5)
+    # Round half up: 2.5 gives 3.
+    # round() would give 2, because it rounds to the even number.
+    return math.floor(price * 0.5 + 0.5)
 
 
 def main():
     for price in (3, 5, 7):
         print(f"A {price}-dollar lunch gives {points(price)} points.")
